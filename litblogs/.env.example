# Application runtime
APP_ENV=development
LOCAL_PASSWORD_REGISTRATION_ENABLED=true
DATABASE_URL=sqlite:///./litblogs.db
LITBLOGS_MIGRATION_DATABASE_URL=sqlite:///./litblogs.db
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=litblogs-local
JWT_CLOCK_SKEW_SECONDS=5
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_DATABASE_ON_STARTUP=false
API_DOCS_ENABLED=false

# Administrative provisioning values. Generate unique values for each environment.
ADMIN_ACCESS_CODE=replace-with-admin-access-code
ADMIN_CODE=replace-with-admin-code
TEACHER_INVITE_HMAC_KEY=replace-with-a-distinct-random-key-of-at-least-32-bytes

# Production database URLs must use PostgreSQL with sslmode=verify-full.
# Keep CA material outside the repository and point sslrootcert to its managed path.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=900
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# Browser and API origins for local development. Separate multiple CORS origins with commas.
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production requires distinct __Host- cookie names and SESSION_COOKIE_SECURE=true.
ALLOWED_HOSTS=localhost
SESSION_COOKIE_NAME=litblog-session
CSRF_COOKIE_NAME=litblog-csrf
SESSION_COOKIE_SECURE=false

# OAuth providers. Leave blank only when the matching sign-in option is disabled.
ALLOWED_EMAIL_DOMAINS=replace-with-approved-domain
GOOGLE_CLIENT_ID=replace-with-google-client-id
MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
MICROSOFT_ALLOWED_TENANT_IDS=replace-with-approved-microsoft-tenant-id
OAUTH_HTTP_TIMEOUT_SECONDS=5
OAUTH_JWKS_CACHE_SECONDS=300

# Web push is intentionally blocked in production until endpoint SSRF controls exist.
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_REMINDER_INTERVAL_SECONDS=3600
PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
PUSH_DELIVERY_TIMEOUT_SECONDS=5

# SMTP settings. Port 1025 is a common local mail-catcher default.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SMTP_TIMEOUT_SECONDS=5
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com
PASSWORD_RESET_WORKER_ENABLED=true
PASSWORD_RESET_WORKER_INTERVAL_SECONDS=5
PASSWORD_RESET_CLAIM_TIMEOUT_SECONDS=120

# Upload storage/scanning. Production requires a pre-created, service-owned
# external directory and a local/private scanner host in the explicit allowlist.
UPLOAD_ROOT=
UPLOAD_SCANNER_REQUIRED=false
UPLOAD_SCANNER_HOST=
UPLOAD_SCANNER_ALLOWED_HOSTS=
UPLOAD_SCANNER_PORT=3310
UPLOAD_SCANNER_TIMEOUT_SECONDS=5
# Leave these false until the independently reviewed migration, fail-closed
# legacy import, and coupled database/object-store restore rehearsal finish.
UPLOAD_REGISTRY_SCHEMA_READY=false
UPLOAD_LEGACY_IMPORT_COMPLETE=false
UPLOAD_BACKUP_RESTORE_VERIFIED=false

# Frontend path, development proxy, and local password-registration UI setting.
# OAuth identifiers and the CSRF cookie name are served by the backend's public
# runtime-config endpoint.
VITE_LOCAL_PASSWORD_REGISTRATION_ENABLED=true
VITE_APP_BASE_PATH=/
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
