# Application runtime
APP_ENV=development
DATABASE_URL=sqlite:///./litblogs.db
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_DATABASE_ON_STARTUP=false

# Access codes used by the application. Generate unique values for each environment.
ADMIN_ACCESS_CODE=replace-with-admin-access-code
TEACHER_ACCESS_CODE=replace-with-teacher-access-code
ADMIN_CODE=replace-with-admin-code

# Browser and API origins for local development. Separate multiple CORS origins with commas.
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OAuth providers. Leave blank only when the matching sign-in option is disabled.
ALLOWED_EMAIL_DOMAINS=replace-with-approved-domain
GOOGLE_CLIENT_ID=replace-with-google-client-id
MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
MICROSOFT_ALLOWED_TENANT_IDS=replace-with-approved-microsoft-tenant-id
OAUTH_HTTP_TIMEOUT_SECONDS=5
OAUTH_JWKS_CACHE_SECONDS=300

# Web push credentials. Generate a VAPID key pair for deployed environments.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
PUSH_REMINDER_INTERVAL_SECONDS=3600
PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
PUSH_DELIVERY_TIMEOUT_SECONDS=5

# SMTP settings. Port 1025 is a common local mail-catcher default.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SMTP_TIMEOUT_SECONDS=5
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com
PASSWORD_RESET_WORKER_ENABLED=true
PASSWORD_RESET_WORKER_INTERVAL_SECONDS=5
PASSWORD_RESET_CLAIM_TIMEOUT_SECONDS=120

# Frontend build and development server settings.
VITE_APP_BASE_PATH=/
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_CSP_CONNECT_SRC=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
VITE_MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
