# Application runtime
APP_ENV=development
DATABASE_URL=sqlite:///./litblogs.db
LITBLOGS_MIGRATION_DATABASE_URL=sqlite:///./litblogs.db
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=litblogs-local
JWT_CLOCK_SKEW_SECONDS=5
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_DATABASE_ON_STARTUP=false
API_DOCS_ENABLED=false

# Production database URLs must use PostgreSQL with sslmode=verify-full.
# Keep CA material outside the repository and point sslrootcert to its managed path.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=900
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# Teacher provisioning code. Generate a unique value for each environment.
TEACHER_ACCESS_CODE=replace-with-teacher-access-code

# Browser and API origins for local development. Separate multiple CORS origins with commas.
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost
SESSION_COOKIE_NAME=litblog-session
CSRF_COOKIE_NAME=litblog-csrf
SESSION_COOKIE_SECURE=false

# OAuth providers. Leave blank only when the matching sign-in option is disabled.
ALLOWED_EMAIL_DOMAINS=replace-with-approved-domain
GOOGLE_CLIENT_ID=replace-with-google-client-id
MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
MICROSOFT_ALLOWED_TENANT_IDS=replace-with-approved-microsoft-tenant-id
OAUTH_HTTP_TIMEOUT_SECONDS=5
OAUTH_JWKS_CACHE_SECONDS=300

# Web push is intentionally blocked in production until endpoint SSRF controls exist.
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# SMTP settings. Port 1025 is a common local mail-catcher default.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com

# Frontend path and development proxy settings. OAuth identifiers and the CSRF
# cookie name are served by the backend's public runtime-config endpoint.
VITE_APP_BASE_PATH=/
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
