# Non-secret inputs for the physically or logically isolated restore host.
RESTORE_RELEASE=/opt/litblogs/releases/REPLACE_WITH_EXACT_RELEASE_ID
REVIEWED_SHA=REPLACE_WITH_REVIEWED_40_CHARACTER_SHA
RESTORE_MANIFEST=/srv/litblogs-restore/staging/REPLACE_WITH_ACCEPTED_SET.manifest.json
RESTORE_UPLOAD_TARGET=/srv/litblogs-restore/REPLACE_WITH_NEW_UPLOAD_TARGET
RESTORE_DATABASE=litblog_restore_verify_REPLACE_WITH_UNIQUE_SUFFIX
POSTGRES_SERVER_CERT_SOURCE=REPLACE_WITH_REHEARSAL_PKI_FULLCHAIN_PATH
POSTGRES_SERVER_KEY_SOURCE=REPLACE_WITH_REHEARSAL_PKI_PRIVATE_KEY_PATH
POSTGRES_ROOT_CA_SOURCE=REPLACE_WITH_REHEARSAL_PKI_CA_PATH

# Change only after school IT signs the no-route/no-credential isolation check.
ISOLATION_APPROVED=false
