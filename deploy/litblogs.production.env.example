APP_ENV=production
LOCAL_PASSWORD_REGISTRATION_ENABLED=true
DATABASE_URL=postgresql://litblogs_runtime:<percent-encoded-runtime-password>@127.0.0.1:5432/litblogs?sslmode=verify-full&sslrootcert=/etc/litblogs/postgres-root-ca.pem
SECRET_KEY=<managed-random-value-at-least-32-bytes-and-12-distinct-characters>
TEACHER_INVITE_HMAC_KEY=<different-managed-random-value-at-least-32-bytes-and-8-distinct-characters>
JWT_ISSUER=https://<real-host>
JWT_AUDIENCE=litblogs-production
JWT_CLOCK_SKEW_SECONDS=5
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=https://<real-host>
BASE_URL=https://<real-host>
CORS_ALLOWED_ORIGINS=https://<real-host>
ALLOWED_HOSTS=<real-host>
ALLOWED_EMAIL_DOMAINS=<real-school-email-domain>
SESSION_COOKIE_NAME=__Host-litblogs-session
CSRF_COOKIE_NAME=__Host-litblogs-csrf
SESSION_COOKIE_SECURE=true
RESET_DATABASE_ON_STARTUP=false
API_DOCS_ENABLED=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=900
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_ALLOWED_TENANT_IDS=
OAUTH_HTTP_TIMEOUT_SECONDS=5
OAUTH_JWKS_CACHE_SECONDS=300
EMAIL_HOST=<approved-starttls-smtp-host>
EMAIL_PORT=587
EMAIL_SMTP_TIMEOUT_SECONDS=5
EMAIL_USERNAME=<managed-smtp-user>
EMAIL_PASSWORD=<managed-smtp-password-at-least-16-bytes>
EMAIL_FROM=<approved-school-sender>
PASSWORD_RESET_WORKER_ENABLED=true
PASSWORD_RESET_WORKER_INTERVAL_SECONDS=5
PASSWORD_RESET_CLAIM_TIMEOUT_SECONDS=120
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
UPLOAD_ROOT=/var/lib/litblogs/uploads
UPLOAD_SCANNER_REQUIRED=true
UPLOAD_SCANNER_HOST=127.0.0.1
UPLOAD_SCANNER_ALLOWED_HOSTS=127.0.0.1
UPLOAD_SCANNER_PORT=3310
UPLOAD_SCANNER_TIMEOUT_SECONDS=5
UPLOAD_REGISTRY_SCHEMA_READY=false
UPLOAD_LEGACY_IMPORT_COMPLETE=false
UPLOAD_BACKUP_RESTORE_VERIFIED=false
