[Unit]
Description=Dispatch LitBlogs assignment reminders once
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=litblogs
Group=litblogs
WorkingDirectory=/opt/litblogs/current/litblogs
EnvironmentFile=/etc/litblogs/litblogs.env
ExecStart=/opt/litblogs/current/.venv/bin/python -m reminder_job
RuntimeMaxSec=300
UMask=0027

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectHostname=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/litblogs /var/log/litblogs
