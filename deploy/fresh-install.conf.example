# Non-secret, root-owned inputs for deploy/scripts/fresh_server_setup.sh.
# Replace every REPLACE_WITH value, then leave approval gates false until the
# named evidence exists in the school change record.
SITE_HOST=REPLACE_WITH_PUBLIC_DNS_NAME
SCHOOL_EMAIL_DOMAIN=REPLACE_WITH_SCHOOL_EMAIL_DOMAIN
ACME_CONTACT_EMAIL=REPLACE_WITH_ACME_CONTACT_EMAIL
RELEASE_ID=REPLACE_WITH_APPROVED_RELEASE_ID
REVIEWED_SHA=REPLACE_WITH_REVIEWED_40_CHARACTER_SHA
POSTGRES_SERVER_CERT_SOURCE=REPLACE_WITH_SCHOOL_PKI_FULLCHAIN_PATH
POSTGRES_SERVER_KEY_SOURCE=REPLACE_WITH_SCHOOL_PKI_PRIVATE_KEY_PATH
POSTGRES_ROOT_CA_SOURCE=REPLACE_WITH_SCHOOL_PKI_CA_PATH
REVIEWED_OPERATOR=REPLACE_WITH_APPROVED_OPERATOR_ID

# A human changes a gate to true only after recording the corresponding proof.
HOST_FIREWALL_APPROVED=false
EGRESS_POLICY_APPROVED=false
RESTORE_REHEARSAL_APPROVED=false
RECOVERY_POLICY_APPROVED=false
