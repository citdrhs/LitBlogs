[Unit]
Description=Authenticated encrypted LitBlogs database and upload backup
Requires=docker.service
After=docker.service litblogs-cit.service
PartOf=litblogs-cit.service
ConditionPathExists=!/home/litblogs/.local/state/cit-deploy/update-blocked.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecCondition=/usr/bin/systemctl --quiet is-active litblogs-cit.service
ExecStart=/usr/bin/python3 /home/litblogs/.local/state/cit-deploy/backup.py backup
TimeoutStartSec=3600
KillSignal=SIGINT
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
