# Container deployment settings. Copy to an ignored .env, never commit secrets.
# These are deliberately incomplete; the application must reject placeholders.
LITBLOGS_ORIGIN=https://YOUR-EXCLUSIVE-HOSTNAME
LITBLOGS_HTTP_PORT=5000
ALLOWED_EMAIL_DOMAINS=YOUR-SCHOOL-EMAIL-DOMAIN

# Generate a DIFFERENT random value for every field below. Use 48+ random bytes.
POSTGRES_PASSWORD=
LITBLOGS_DB_PASSWORD=
LITBLOGS_MIGRATOR_PASSWORD=
LITBLOGS_ACCOUNT_OPERATOR_PASSWORD=
LITBLOGS_INVITATION_OPERATOR_PASSWORD=
LITBLOGS_BACKUP_PASSWORD=
SECRET_KEY=
TEACHER_INVITE_HMAC_KEY=

# Approved authenticated STARTTLS SMTP. Registration/reset mail requires this.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Only attest after the corresponding checks in CIT_DEPLOY.md have been done.
UPLOAD_LEGACY_IMPORT_COMPLETE=false
UPLOAD_BACKUP_RESTORE_VERIFIED=false

# Password registration stays enabled. Google is hidden until explicitly approved.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
