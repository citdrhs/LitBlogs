# This file powers both password reset and mandatory email verification.
DATABASE_URL=postgresql://litblogs_runtime:<percent-encoded-runtime-password>@127.0.0.1:5432/litblogs?sslmode=verify-full&sslrootcert=/etc/litblogs/postgres-root-ca.pem
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=900
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
FRONTEND_URL=https://<real-host>
EMAIL_HOST=<approved-starttls-smtp-host>
EMAIL_PORT=587
EMAIL_SMTP_TIMEOUT_SECONDS=5
EMAIL_USERNAME=<managed-smtp-user>
EMAIL_PASSWORD=<managed-smtp-password-at-least-16-bytes>
EMAIL_FROM=<approved-school-sender>
PASSWORD_RESET_CLAIM_TIMEOUT_SECONDS=120
